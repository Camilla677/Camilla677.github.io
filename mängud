<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Y2K NEON SNAKE</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
    @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

    body {
        margin: 0;
        padding: 0;
        background: #05000f;
        color: white;
        font-family: 'Press Start 2P', monospace;
        overflow: hidden;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: url('https://cur.cursors-4u.net/cursors/cur-9/cur817.cur'), auto;
    }

    .game-container {
        position: relative;
        border: 4px solid #ff00ff;
        box-shadow: 0 0 40px #ff00ff88;
        background: #0a0014;
    }

    canvas {
        display: block;
        image-rendering: pixelated;
    }

    .overlay {
        position: absolute;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(10, 0, 20, 0.9);
        z-index: 100;
    }

    .game-over {
        text-align: center;
        padding: 30px 50px;
        border: 3px solid #ff00ff;
        background: #1a0033;
    }

    .title {
        color: #ff00ff;
        font-size: 28px;
        text-shadow: 0 0 15px #ff00ff;
        margin-bottom: 10px;
    }

    button {
        margin-top: 20px;
        padding: 12px 32px;
        background: #ff00ff;
        color: black;
        border: none;
        font-family: 'Press Start 2P', monospace;
        font-size: 14px;
        cursor: pointer;
        box-shadow: 0 0 20px #ff00ff;
    }

    button:hover {
        background: #ffff00;
        color: black;
    }
</style>
</head>
<body>

<div class="game-container">
    <canvas id="canvas" width="616" height="484"></canvas>
    
    <div id="gameOver" class="overlay">
        <div class="game-over">
            <div class="title">GAME OVER</div>
            <div style="color:#00ffff; margin:15px 0; font-size:18px;">SCORE: <span id="finalScore">0</span></div>
            <button onclick="restartGame()">PLAY AGAIN</button>
        </div>
    </div>
</div>

<script>
// ============== Y2K NEON SNAKE ==============
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const CELL = 22;
const COLS = 28;
const ROWS = 22;

let snake, dir, nextDir, food, score, gameOver, particles, lastTick;

function init() {
    snake = [
        {x: 14, y: 11},
        {x: 13, y: 11},
        {x: 12, y: 11}
    ];
    dir = {x: 1, y: 0};
    nextDir = {x: 1, y: 0};
    food = newFood();
    score = 0;
    gameOver = false;
    particles = [];
    lastTick = Date.now();
}

function newFood() {
    let pos;
    do {
        pos = { x: Math.floor(Math.random() * COLS), y: Math.floor(Math.random() * ROWS) };
    } while (snake.some(s => s.x === pos.x && s.y === pos.y));
    return pos;
}

function draw() {
    // Background
    ctx.fillStyle = '#0a0014';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Grid
    ctx.strokeStyle = 'rgba(255, 0, 255, 0.08)';
    for (let x = 0; x <= COLS; x++) {
        ctx.beginPath();
        ctx.moveTo(x * CELL, 0);
        ctx.lineTo(x * CELL, canvas.height);
        ctx.stroke();
    }
    for (let y = 0; y <= ROWS; y++) {
        ctx.beginPath();
        ctx.moveTo(0, y * CELL);
        ctx.lineTo(canvas.width, y * CELL);
        ctx.stroke();
    }

    // Particles
    particles = particles.filter(p => {
        p.x += p.vx;
        p.y += p.vy;
        p.life -= 0.06;
        if (p.life <= 0) return false;

        ctx.globalAlpha = p.life;
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 12;
        ctx.fillRect(p.x - 4, p.y - 4, 8, 8);
        return true;
    });
    ctx.globalAlpha = 1;
    ctx.shadowBlur = 0;

    // Food
    const fx = food.x * CELL + CELL / 2;
    const fy = food.y * CELL + CELL / 2;
    const pulse = Math.sin(Date.now() / 180) * 3;

    ctx.shadowColor = '#ff00ff';
    ctx.shadowBlur = 25;
    ctx.fillStyle = '#ff00ff';
    ctx.beginPath();
    ctx.arc(fx, fy, CELL/2 - 4 + pulse, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;

    // Snake
    snake.forEach((seg, i) => {
        const hue = 160 + (i * 5);
        ctx.fillStyle = i === 0 ? '#00ffff' : `hsl(${hue}, 100%, 65%)`;
        ctx.shadowColor = i === 0 ? '#00ffff' : '#00ff99';
        ctx.shadowBlur = i === 0 ? 20 : 10;

        ctx.fillRect(seg.x * CELL + 2, seg.y * CELL + 2, CELL - 4, CELL - 4);

        // Head eyes
        if (i === 0) {
            ctx.fillStyle = '#000';
            ctx.shadowBlur = 0;
            const ex = dir.x * 6;
            const ey = dir.y * 6;
            ctx.fillRect(seg.x * CELL + CELL/2 + ex - 3, seg.y * CELL + CELL/2 + ey - 3, 6, 6);
        }
    });

    // Score
    ctx.fillStyle = '#ff00ff';
    ctx.shadowColor = '#ff00ff';
    ctx.shadowBlur = 12;
    ctx.font = 'bold 18px monospace';
    ctx.fillText(`SCORE ${score}`, 20, 35);
}

function update() {
    if (gameOver) return;

    dir = nextDir;

    const head = { 
        x: (snake[0].x + dir.x + COLS) % COLS, 
        y: (snake[0].y + dir.y + ROWS) % ROWS 
    };

    // Self collision
    if (snake.some(s => s.x === head.x && s.y === head.y)) {
        gameOver = true;
        document.getElementById('gameOver').style.display = 'flex';
        document.getElementById('finalScore').textContent = score;
        return;
    }

    snake.unshift(head);

    // Eat food
    if (head.x === food.x && head.y === food.y) {
        score++;
        for (let i = 0; i < 16; i++) {
            particles.push({
                x: food.x * CELL + CELL / 2,
                y: food.y * CELL + CELL / 2,
                vx: (Math.random() - 0.5) * 8,
                vy: (Math.random() - 0.5) * 8,
                life: 1.2,
                color: Math.random() > 0.5 ? '#ff00ff' : '#00ffff'
            });
        }
        food = newFood();
    } else {
        snake.pop();
    }
}

function gameLoop() {
    const now = Date.now();
    const speed = Math.max(50, 160 - score * 6);

    if (now - lastTick > speed) {
        update();
        lastTick = now;
    }

    draw();
    requestAnimationFrame(gameLoop);
}

// Controls
document.addEventListener('keydown', e => {
    if (gameOver) return;

    const map = {
        ArrowUp: {x:0,y:-1}, KeyW: {x:0,y:-1},
        ArrowDown: {x:0,y:1}, KeyS: {x:0,y:1},
        ArrowLeft: {x:-1,y:0}, KeyA: {x:-1,y:0},
        ArrowRight: {x:1,y:0}, KeyD: {x:1,y:0}
    };

    const newDir = map[e.code];
    if (newDir && !(newDir.x === -dir.x && newDir.y === -dir.y)) {
        nextDir = newDir;
    }
});

window.restartGame = function() {
    init();
    document.getElementById('gameOver').style.display = 'none';
};

// Start the game
init();
gameLoop();

</script>

</body>
</html>
